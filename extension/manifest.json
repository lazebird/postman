{
  "manifest_version": 3,
  "name": "Edge Mail Notifier",
  "version": "0.8.0",
  "description": "自动恢复会话：定时检查失败时自动打开后台标签恢复会话并读取未读数，读后即关；含冷却控制避免频繁打扰",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "tabs",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*",
    "https://*.163.com/*",
    "https://mail.qq.com/*",
    "https://*.qq.com/*",
    "https://mail.ustc.edu.cn/*",
    "https://*.ustc.edu.cn/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*",
        "https://*.mail.163.com/*",
        "https://mail.qq.com/*",
        "https://*.mail.qq.com/*"
      ],
      "js": [
        "content/probe-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Mail Notifier"
  },
  "options_page": "options/index.html"
}
